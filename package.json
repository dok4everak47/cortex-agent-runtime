{
  "name": "laravel-mcp-server",
  "version": "0.5.0",
  "type": "module",
  "description": "MCP server for Laravel development tools",
  "main": "dist/index.js",
  "files": ["dist"],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "npx tsx src/index.ts",
    "test": "tsx --experimental-test-module-mocks --test src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^22.0.0"
  }
}
